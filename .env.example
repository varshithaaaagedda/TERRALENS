# ==============================================================================
# TerraLens Climate Intelligence Platform - Environment Variables Template
# Enterprise Production Environment Configuration
# ==============================================================================

# AI Agent Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Blockchain & Testnet Configuration
# Supported Testnets: Polygon Amoy (80002), Ethereum Sepolia (11155111), Local Hardhat (31337)
RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_NETWORK=Polygon Amoy Testnet (ChainId: 80002)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCK_EXPLORER_BASE=https://amoy.polygonscan.com/tx/

# Authorized Backend Submitter Private Key (Testnet only, never use real funds)
# Default Hardhat local testnet key #0:
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Public Telemetry & Data Sources (No API keys required for public endpoints)
EPA_GPP_API_ENDPOINT=https://www.epa.gov/greenpower
EIA_API_ENDPOINT=https://api.eia.gov/v2/electricity/
RE100_REGISTRY_URL=https://www.there100.org
